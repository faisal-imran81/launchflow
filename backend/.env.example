# ─────────────────────────────────────────────
# LaunchFlow — Backend Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
# Port the Express server listens on
PORT=3000

# ── Supabase ──────────────────────────────────
# Your Supabase project URL
# Found at: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (server-side only — never expose to the client)
# Found at: https://app.supabase.com → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Groq API ──────────────────────────────────
# API key for Groq LLM (used for Dockerfile + GitHub Actions generation)
# Get one free at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ── GitHub ────────────────────────────────────
# GitHub Personal Access Token (for fetching repository data)
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (read), public_repo
GITHUB_TOKEN=your-github-personal-access-token

# ── AWS Credentials ───────────────────────────
# AWS IAM user access key ID
# Create an IAM user at: https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS IAM user secret access key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS region where your ECR and EC2 resources are located
# Example: us-east-1, eu-west-1, ap-south-1
AWS_REGION=us-east-1

# Your 12-digit AWS account ID
# Found at: https://console.aws.amazon.com → Account menu (top right)
AWS_ACCOUNT_ID=123456789012

# ── AWS ECR ───────────────────────────────────
# Full ECR registry URL
# Format: <AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# ── AWS EC2 ───────────────────────────────────
# Public IP address or DNS hostname of your EC2 instance
EC2_HOST=your-ec2-public-ip-or-dns

# SSH username for your EC2 instance
# Default for Ubuntu AMIs: ubuntu
# Default for Amazon Linux AMIs: ec2-user
EC2_USERNAME=ubuntu

# Absolute path to your EC2 SSH private key (.pem file) on your local machine
EC2_SSH_KEY_PATH=/absolute/path/to/your-key.pem
